# News-briefing evaluator configuration template. Copy this file to evaluator/.env.
# evaluator/.env is ignored so provider credentials cannot be committed accidentally.
# Model catalog provenance: 2026-08-11.
# Re-check identifiers before a long or expensive run; provider catalogs change.
EVALUATOR_MAX_TOKENS=8192

# Codex CLI models (official OpenAI model catalog, checked 2026-08-11):
# https://developers.openai.com/api/docs/models
# gpt-5.6-sol
# gpt-5.6-terra
# gpt-5.6-luna
CODEX_MODEL=gpt-5.6-terra

# Claude Code --model values (official Anthropic model overview, checked 2026-08-11):
# https://platform.claude.com/docs/en/about-claude/models/overview
# claude-fable-5
# claude-opus-5
# claude-sonnet-5
# claude-haiku-4-5-20251001
CLAUDE_CODE_MODEL=claude-sonnet-5

# OpenRouter text models (catalog/API docs checked 2026-08-11):
# https://openrouter.ai/docs/guides/overview/models
# The full current list is always available from GET https://openrouter.ai/api/v1/models
# openai/gpt-5.6-sol
# openai/gpt-5.6-terra
# anthropic/claude-sonnet-5
# ~google/gemini-pro-latest
OPENROUTER_MODEL=openai/gpt-5.6-terra
OPENROUTER_API_KEY=
# Optional attribution header:
OPENROUTER_HTTP_REFERER=

# NVIDIA hosted NIM models (official LLM API catalog, checked 2026-08-11):
# https://docs.api.nvidia.com/nim/reference/llm-apis
# nvidia/nemotron-3-ultra-550b-a55b
# openai/gpt-oss-120b
# qwen/qwen3-coder-480b-a35b-instruct
# moonshotai/kimi-k2-thinking
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_API_KEY=
# NVIDIA does not consistently return billed USD. Set these to estimate cost.
NVIDIA_INPUT_USD_PER_MTOK=
NVIDIA_OUTPUT_USD_PER_MTOK=
